<Window x:Class="SpeccyStudio.SpriteBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal 8-Bit Sprite &amp; Tile Bank — Speccy Studio"
        Width="980" Height="680" MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar: Search & Filters -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Search Box -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="SearchBox" Width="240" Padding="8,5" TextChanged="SearchBox_TextChanged" ToolTip="Search by name, ID or tag (e.g. pipe, turret, pod, hazard)"/>
        </StackPanel>

        <!-- Game Source Filter -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Game:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <ComboBox x:Name="GameSourceCombo" Width="170" SelectionChanged="Filter_Changed">
            <ComboBoxItem Content="All Games" IsSelected="True"/>
            <ComboBoxItem Content="Cybernoid II (1988)"/>
            <ComboBoxItem Content="Exolon (1987)"/>
            <ComboBoxItem Content="Rex (1988) [128K]"/>
            <ComboBoxItem Content="Myth (1989) [128K]"/>
            <ComboBoxItem Content="Custom Vault"/>
          </ComboBox>
        </StackPanel>

        <!-- Category Filter -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <ComboBox x:Name="CategoryCombo" Width="140" SelectionChanged="Filter_Changed">
            <ComboBoxItem Content="All Categories" IsSelected="True"/>
            <ComboBoxItem Content="Characters"/>
            <ComboBoxItem Content="Terrain"/>
            <ComboBoxItem Content="Platforms"/>
            <ComboBoxItem Content="Enemies"/>
            <ComboBoxItem Content="Hazards"/>
            <ComboBoxItem Content="Structures"/>
            <ComboBoxItem Content="Interactive"/>
            <ComboBoxItem Content="Scenery"/>
            <ComboBoxItem Content="Markers"/>
            <ComboBoxItem Content="Fonts &amp; Typography"/>
          </ComboBox>
        </StackPanel>

        <!-- Status / Count & Quick Pick Option -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Border Background="#1D2A42" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
            <TextBlock x:Name="ItemCountText" Text="0 items" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
          </Border>
          <CheckBox x:Name="QuickPickCheck" Content="Click to Pick &amp; Close" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" ToolTip="When checked, left-clicking any tile copies it to your brush and immediately closes the window ready for painting"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content: Left Gallery + Right Inspector -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Gallery of Sprite Cards -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <WrapPanel x:Name="SpriteWrapPanel" Orientation="Horizontal" ItemWidth="96" ItemHeight="116"/>
        </ScrollViewer>
      </Border>

      <!-- Right: Detail & Action Inspector -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Large 8x Preview -->
          <Border Grid.Row="0" Background="#06080D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="140" Margin="0,0,0,12">
            <Grid>
              <Image x:Name="SelectedPreviewImage" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="12"/>
              <!-- Flip Controls overlay -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                <Button x:Name="FlipHBtn" Content="⇄" Click="FlipH_Click" Width="26" Height="26" Padding="0" ToolTip="Preview Horizontally Flipped"/>
                <Button x:Name="FlipVBtn" Content="⇅" Click="FlipV_Click" Width="26" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Preview Vertically Flipped"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Meta Info -->
          <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="SelectedNameText" Text="Select a Sprite" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SelectedGameText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <Border Background="#1A2536" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                <TextBlock x:Name="SelectedDimText" Text="—" FontSize="11" Foreground="#72BDE8"/>
              </Border>
              <Border Background="#1A2536" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                <TextBlock x:Name="SelectedCategoryText" Text="—" FontSize="11" Foreground="#FFD166"/>
              </Border>
              <Border Background="#1A2536" CornerRadius="4" Padding="6,2">
                <TextBlock x:Name="SelectedBytesText" Text="—" FontSize="11" Foreground="#06D6A0"/>
              </Border>
            </StackPanel>
            <TextBlock x:Name="SelectedDescText" Text="Click any tile or sprite from the bank to inspect, flip, and inject into your loaded game." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>

          <!-- Middle spacer -->
          <Border Grid.Row="2"/>

          <!-- Action Buttons -->
          <StackPanel Grid.Row="3">
            <Button x:Name="CopyBrushBtn" Content="📋 Pick &amp; Paint in Level (Close)" Click="CopyBrush_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" IsEnabled="False" ToolTip="Copy this sprite to active pencil brush and close to paint on canvas immediately"/>
            <Button x:Name="CopyToClipboardBtn" Content="📋 Copy to Clipboard (Ctrl+C)" Click="CopyToClipboard_Click" Margin="0,0,0,6" IsEnabled="False" ToolTip="Copy sprite image to Windows clipboard and update active level brush"/>
            <Button x:Name="InjectCybernoidBtn" Content="📥 Inject into Active Tile (Cybernoid II)" Click="InjectCybernoid_Click" Margin="0,0,0,6" IsEnabled="False" ToolTip="Write this graphic directly into Cybernoid II's tile atlas"/>
            <Button x:Name="ExportPngBtn" Content="📸 Export Sprite PNG" Click="ExportPng_Click" Margin="0,0,0,6" IsEnabled="False" ToolTip="Save pixel-perfect PNG image"/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="📦 Export Bank" Click="ExportBank_Click" Margin="0,0,4,0" ToolTip="Export sprite bank to .speccybank JSON"/>
              <Button Grid.Column="1" Content="📂 Import Bank" Click="ImportBank_Click" Margin="4,0,0,0" ToolTip="Import custom .speccybank JSON file"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom Status Bar -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" Text="Universal 8-Bit Sprite &amp; Tile Bank ready." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
      <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Padding="14,4"/>
    </Grid>
  </Grid>
</Window>
