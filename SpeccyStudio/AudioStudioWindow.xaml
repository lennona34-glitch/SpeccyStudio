<Window x:Class="SpeccyStudio.AudioStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AY-3-8912 &amp; 48K Beeper Audio Studio — Speccy Studio"
        Width="1200" Height="680" MinWidth="1000" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar: Track Selector, Transport Controls & Exporter -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Track Picker & Playback Controls -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🎵 " FontSize="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock Text="Soundtrack:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0"/>
          <ComboBox x:Name="TrackSelectorCombo" Width="290" SelectionChanged="TrackSelector_SelectionChanged">
            <ComboBoxItem Content="Myth: History in the Making (Main Theme)" IsSelected="True"/>
            <ComboBoxItem Content="Rex (Neon Infiltration Theme)"/>
            <ComboBoxItem Content="Cybernoid II: The Revenge (Space Armada)"/>
            <ComboBoxItem Content="Exolon (Frontier Recon Battle)"/>
          </ComboBox>

          <Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click" Width="70" Margin="10,0,0,0" Background="#1D4A32" Foreground="#4EFA94" FontWeight="Bold"/>
          <Button x:Name="StopButton" Content="⏹ Stop" Click="Stop_Click" Width="70" Margin="6,0,0,0" Background="#3D1E22" Foreground="#FA5A68"/>

          <CheckBox x:Name="LoopCheck" Content="Loop" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Center: Position Slider & Time Display -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
          <TextBlock x:Name="TimeText" Text="00:00 / 00:30" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ProgressBar x:Name="TrackProgressBar" Minimum="0" Maximum="30" Value="0" Height="8" Width="200" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Background="#131E2E"/>
        </StackPanel>

        <!-- Right: Master Volume & WAV Export -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="90" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
          <Button x:Name="ExportWavButton" Content="💾 Export .WAV" Click="ExportWav_Click" Margin="12,0,0,0" Background="#1D2A42" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" ToolTip="Export current track with your live parameter tweaks to standard 44.1kHz WAV"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Workspace: 3 Columns (Channels, Register Inspector, Control Lab + Soundboard) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Column 0: Live Channel Visualizers & Meters -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="LIVE PSG CHANNELS (AY-3-8912)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

            <!-- Channel A Card -->
            <Border Background="#131E2E" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <TextBlock Text="Channel A (Lead Melody)" FontWeight="Bold" Foreground="#00D2FF"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MuteABtn" Content="Mute" Click="MuteA_Click" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                    <Button x:Name="SoloABtn" Content="Solo" Click="SoloA_Click" Padding="6,2" FontSize="10"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ChanAText" Grid.Row="1" Text="Tone: Period 425 · 440 Hz · Vol 14" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ProgressBar x:Name="MeterBarA" Grid.Row="2" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#00D2FF" Background="#0A101A"/>
              </Grid>
            </Border>

            <!-- Channel B Card -->
            <Border Background="#131E2E" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <TextBlock Text="Channel B (Bassline)" FontWeight="Bold" Foreground="#00E676"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MuteBBtn" Content="Mute" Click="MuteB_Click" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                    <Button x:Name="SoloBBtn" Content="Solo" Click="SoloB_Click" Padding="6,2" FontSize="10"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ChanBText" Grid.Row="1" Text="Tone: Period 850 · 220 Hz · Vol 13" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ProgressBar x:Name="MeterBarB" Grid.Row="2" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#00E676" Background="#0A101A"/>
              </Grid>
            </Border>

            <!-- Channel C Card -->
            <Border Background="#131E2E" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <TextBlock Text="Channel C (Harmony / Arp)" FontWeight="Bold" Foreground="#FFD600"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MuteCBtn" Content="Mute" Click="MuteC_Click" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                    <Button x:Name="SoloCBtn" Content="Solo" Click="SoloC_Click" Padding="6,2" FontSize="10"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ChanCText" Grid.Row="1" Text="Tone: Period 638 · 293 Hz · Vol 11" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ProgressBar x:Name="MeterBarC" Grid.Row="2" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#FFD600" Background="#0A101A"/>
              </Grid>
            </Border>

            <!-- Noise Generator Card -->
            <Border Background="#131E2E" BorderBrush="#FF4081" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <TextBlock Text="Noise Generator (17-bit LFSR)" FontWeight="Bold" Foreground="#FF4081"/>
                  <Button x:Name="MuteNoiseBtn" HorizontalAlignment="Right" Content="Mute" Click="MuteNoise_Click" Padding="6,2" FontSize="10"/>
                </Grid>
                <TextBlock x:Name="NoiseText" Grid.Row="1" Text="Period: 6 (R6) · Routed to: A, C" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ProgressBar x:Name="MeterBarNoise" Grid.Row="2" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#FF4081" Background="#0A101A"/>
              </Grid>
            </Border>

            <!-- Hardware Envelope Card -->
            <Border Background="#131E2E" BorderBrush="#FF9100" BorderThickness="1" CornerRadius="6" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Hardware Envelope" FontWeight="Bold" Foreground="#FF9100"/>
                <TextBlock x:Name="EnvelopeText" Grid.Row="1" Text="Period: 0x0E00 · Shape 14 (Sawtooth Decay)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ProgressBar x:Name="MeterBarEnv" Grid.Row="2" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#FF9100" Background="#0A101A"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Column 1: Live AY Register Inspector (R0 to R13) -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="PSG REGISTER INSPECTOR (R0–R13)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Ports: $FFFD (Select Register) · $BFFD (Data Write)" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </StackPanel>

          <!-- Register Table with dark theme headers -->
          <DataGrid x:Name="RegisterGrid" Grid.Row="1" Height="370" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#101826" RowBackground="#101826" AlternatingRowBackground="#141E2F" BorderThickness="0" Foreground="#E0E6ED">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#172236"/>
                <Setter Property="Foreground" Value="#00D2FF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="BorderBrush" Value="#25354F"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Reg" Binding="{Binding Name}" Width="45" FontFamily="Consolas" FontWeight="Bold"/>
              <DataGridTextColumn Header="Hex" Binding="{Binding HexValue}" Width="48" FontFamily="Consolas" Foreground="#00D2FF"/>
              <DataGridTextColumn Header="Dec" Binding="{Binding DecValue}" Width="48" FontFamily="Consolas" Foreground="#4EFA94"/>
              <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="245" Foreground="#BAC7D5"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Column 2: Parameter Tweaks & 8-Pad SFX Soundboard -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Interactive Parameter Altering Lab -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="LIVE PARAMETER ALTERING &amp; REMIXING" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

            <!-- Pitch Transpose -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Pitch Transpose:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <Slider x:Name="PitchSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="PitchSlider_ValueChanged"/>
              <TextBlock x:Name="PitchText" Grid.Column="2" Text="0 st" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Grid>

            <!-- Tempo Slider -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Playback Tempo:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <Slider x:Name="TempoSlider" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="1.0" VerticalAlignment="Center" ValueChanged="TempoSlider_ValueChanged"/>
              <TextBlock x:Name="TempoText" Grid.Column="2" Text="1.0x" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Grid>

            <!-- Noise Pitch Tweak -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Noise Pitch Tweak:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <Slider x:Name="NoiseTweakSlider" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="NoiseTweakSlider_ValueChanged"/>
              <TextBlock x:Name="NoiseTweakText" Grid.Column="2" Text="0" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Grid>

            <!-- Reset Tweaks Button -->
            <Button Content="↺ Reset Alterations to Original Score" Click="ResetTweaks_Click" Margin="0,4,0,0" Padding="8,4" Background="#1D2A42" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>

        <!-- Bottom: 8-Pad Soundboard -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
              <TextBlock Text="8-PAD SFX AUDITION SOUNDBOARD" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="Press Keys [1]–[8] to fire" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>

            <!-- 8 Trigger Pads (2x4 Grid) -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="4">
              <Button x:Name="Pad1Btn" Tag="SFX_REX_01" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#132438" BorderBrush="#00D2FF" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[1] Rex Plasma Blast" FontWeight="Bold" Foreground="#00D2FF" FontSize="11"/>
                  <TextBlock Text="Heavy cannon discharge with muzzle crackle" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad2Btn" Tag="SFX_REX_02" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#132438" BorderBrush="#00D2FF" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[2] Rex Jet Thruster" FontWeight="Bold" Foreground="#00D2FF" FontSize="11"/>
                  <TextBlock Text="Dual-nozzle vertical jump ascent" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad3Btn" Tag="SFX_REX_03" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#132438" BorderBrush="#00D2FF" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[3] Rex Shield Deflect" FontWeight="Bold" Foreground="#00D2FF" FontSize="11"/>
                  <TextBlock Text="High-frequency oscillating barrier ring" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad4Btn" Tag="SFX_MYTH_01" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#2A1B14" BorderBrush="#FF9100" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[4] Myth Broadsword" FontWeight="Bold" Foreground="#FF9100" FontSize="11"/>
                  <TextBlock Text="Barbarian heavy execution slash" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad5Btn" Tag="SFX_MYTH_02" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#2A1B14" BorderBrush="#FF9100" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[5] Myth Bone Clatter" FontWeight="Bold" Foreground="#FF9100" FontSize="11"/>
                  <TextBlock Text="Rattling skeleton warrior marching" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad6Btn" Tag="SFX_MYTH_03" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#2A1B14" BorderBrush="#FF9100" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[6] Myth Petrify Ray" FontWeight="Bold" Foreground="#FF9100" FontSize="11"/>
                  <TextBlock Text="Gorgon supernatural oscillating hum" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad7Btn" Tag="SFX_CYB_01" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#2A1320" BorderBrush="#FF4081" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[7] Cybernoid Smart Bomb" FontWeight="Bold" Foreground="#FF4081" FontSize="11"/>
                  <TextBlock Text="Screen shockwave detonation" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>

              <Button x:Name="Pad8Btn" Tag="SFX_SPEC_01" Click="SfxPad_Click" Height="50" Margin="3,2" Background="#142A1D" BorderBrush="#4EFA94" BorderThickness="1" HorizontalContentAlignment="Left" Padding="8,2">
                <StackPanel>
                  <TextBlock Text="[8] Speccy 1UP Chime" FontWeight="Bold" Foreground="#4EFA94" FontSize="11"/>
                  <TextBlock Text="Major ascending extra life bonus" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Row 2: Live MIDI Output Control & Routing Bar -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MIDI Device Selector -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="🎹 " FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text="MIDI Out:" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0"/>
          <ComboBox x:Name="MidiDeviceCombo" Width="210" SelectionChanged="MidiDeviceCombo_SelectionChanged" ToolTip="Select Windows MIDI Out device (e.g. loopMIDI Port to connect to Ableton/FL Studio/DAW/VST3, or Microsoft GS Wavetable Synth)"/>
          
          <!-- Live Activity LED Indicator -->
          <Ellipse x:Name="MidiLed" Width="10" Height="10" Fill="#334155" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="MIDI Note Activity"/>
        </StackPanel>

        <!-- Channel Routing Options -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <CheckBox x:Name="MidiMultiChannelCheck" Content="A/B/C -> Ch 1/2/3" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Click="MidiRouting_Changed" ToolTip="Checked: Voice A->Ch1, B->Ch2, C->Ch3. Unchecked: All voices to MIDI Ch 1"/>
          <CheckBox x:Name="MidiDrumsCheck" Content="Noise -> Ch 10 Drums" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Click="MidiRouting_Changed" ToolTip="Translate AY LFSR noise bursts into General MIDI drum triggers on Channel 10"/>
          <CheckBox x:Name="MidiPitchBendCheck" Content="Pitch Bend" IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Click="MidiRouting_Changed" ToolTip="Emit real-time Pitch Bend for authentic chiptune vibrato and portamento"/>
        </StackPanel>

        <!-- Test & Panic Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Button Content="Test Note (440Hz)" Click="MidiTestNote_Click" Padding="8,3" FontSize="11" Background="#1A2D42" Foreground="#00D2FF" Margin="0,0,6,0" ToolTip="Send a test A4 Note On/Off to the active MIDI device"/>
          <Button Content="🚨 Panic" Click="MidiPanic_Click" Padding="8,3" FontSize="11" Background="#3D1E22" Foreground="#FA5A68" ToolTip="Stop all active notes and reset controllers"/>
        </StackPanel>

        <!-- Status / Hardware Target Info -->
        <StackPanel Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Ready · Sound engine initialized" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock x:Name="MidiStatusText" Text="Connect to loopMIDI / loopBe1 for Ableton, Reaper, FL Studio &amp; VST3 plugins" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
