<Window x:Class="SpeccyStudio.RomRipperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Memory &amp; ROM Ripper — Speccy Studio"
        Width="1180" Height="760" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar: Source File, Memory Scrubber & Quick Tools -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Row: Source, Bank Selector, Open File, Auto-Scan -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Source File & Open Button -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#131E2E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 " VerticalAlignment="Center"/>
                <TextBlock x:Name="SourceFileNameText" Text="Active File" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SourceFileSizeText" Text=" (65,536 B)" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button x:Name="OpenFileButton" Content="📂 Open Any File / ROM..." Click="OpenFile_Click" Padding="8,4" ToolTip="Open any TAP, TZX, Z80, SNA, SCR, ROM, BIN, or ZIP file to rip graphics"/>
          </StackPanel>

          <!-- Memory Region Dropdown -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="Region:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox x:Name="MemoryRegionCombo" Width="200" SelectionChanged="MemoryRegion_SelectionChanged">
              <ComboBoxItem Content="Full Buffer (0x0000 - End)" IsSelected="True"/>
              <ComboBoxItem Content="ZX Spectrum 48K ($4000-$FFFF)"/>
              <ComboBoxItem Content="Screen Memory ($4000-$5AFF)"/>
              <ComboBoxItem Content="Game Code / Data ($5B00-$FFFF)"/>
              <ComboBoxItem Content="High Memory ($8000-$FFFF)"/>
            </ComboBox>
          </StackPanel>

          <!-- Auto-Scan & Preset Jump -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AutoScanButton" Content="⚡ Auto-Scan Sprites" Click="AutoScan_Click" Background="#1D2A42" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Padding="10,5" ToolTip="Heuristically scan memory for repeating sprite sheets, tiles &amp; glyphs"/>
          </StackPanel>
        </Grid>

        <!-- Bottom Row: Address Slider, Hex Box, and Precision Step Buttons -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Hex Address Box -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="Address:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0"/>
            <TextBox x:Name="HexAddressBox" Text="$8000" Width="72" Padding="6,4" TextAlignment="Center" FontFamily="Consolas" FontWeight="Bold" KeyDown="HexAddressBox_KeyDown" LostFocus="HexAddressBox_LostFocus" ToolTip="Type hex (e.g. $CDCB or 0x8000) or decimal address and press Enter"/>
            <TextBlock x:Name="DecAddressText" Text="(32,768)" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>

          <!-- Scanline Phase Alignment Controls -->
          <Border Grid.Column="1" Background="#0C1522" BorderBrush="#1C2E46" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Scanline Phase:" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <Button Content="▲ -1 Line" Tag="-1" Click="StepAddress_Click" Padding="6,2" Margin="0,0,2,0" Background="#142436" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" ToolTip="Nudge address backward 1 byte (Shifts scanlines UP to fix cut-off tops) [Shortcut: ▲ or '[']"/>
              <Button Content="▼ +1 Line" Tag="1" Click="StepAddress_Click" Padding="6,2" Margin="0,0,4,0" Background="#142436" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" ToolTip="Nudge address forward 1 byte (Shifts scanlines DOWN) [Shortcut: ▼ or ']']"/>
              <Button x:Name="SnapPhaseButton" Content="🪄 Snap Phase" Click="AutoAlignPhase_Click" Padding="8,2" Background="#183652" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" ToolTip="Magic Scanline Phase Lock: Automatically detects boundary gaps and snaps phase so character tops/bottoms align perfectly! [Shortcut: 'P']"/>
            </StackPanel>
          </Border>

          <!-- Step Buttons Left -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Content="◄◄ 1K" Tag="-1024" Click="StepAddress_Click" Width="44" Padding="0,2" Margin="0,0,2,0" ToolTip="Step backward 1024 bytes"/>
            <Button Content="◄ 256" Tag="-256" Click="StepAddress_Click" Width="42" Padding="0,2" Margin="0,0,2,0" ToolTip="Step backward 256 bytes"/>
            <Button Content="‹ 32" Tag="-32" Click="StepAddress_Click" Width="36" Padding="0,2" Margin="0,0,2,0" ToolTip="Step backward 32 bytes (1 tile)"/>
          </StackPanel>

          <!-- Address Slider -->
          <Slider x:Name="AddressSlider" Grid.Column="3" Minimum="0" Maximum="65535" Value="32768" SmallChange="1" LargeChange="32" ValueChanged="AddressSlider_ValueChanged" VerticalAlignment="Center" Margin="4,0"/>

          <!-- Step Buttons Right -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Content="32 ›" Tag="32" Click="StepAddress_Click" Width="36" Padding="0,2" Margin="0,0,2,0" ToolTip="Step forward 32 bytes (1 tile)"/>
            <Button Content="256 ►" Tag="256" Click="StepAddress_Click" Width="42" Padding="0,2" Margin="0,0,2,0" ToolTip="Step forward 256 bytes"/>
            <Button Content="1K ►►" Tag="1024" Click="StepAddress_Click" Width="44" Padding="0,2" ToolTip="Step forward 1024 bytes"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Main Content: Left Visual Matrix + Right Inspector/Ripper -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="360"/>
      </Grid.ColumnDefinitions>

      <!-- Left Column: Candidate Sprite Matrix / Sheet -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Matrix Header: Zoom, Count, Page Navigation -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="VISUAL MEMORY SHEET" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="MatrixInfoText" Text=" · Showing 32 candidate sprites from $8000" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Zoom:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,6,0"/>
              <ComboBox x:Name="ZoomCombo" Width="65" SelectionChanged="ZoomCombo_SelectionChanged" Margin="0,0,10,0">
                <ComboBoxItem Content="1x"/>
                <ComboBoxItem Content="2x" IsSelected="True"/>
                <ComboBoxItem Content="3x"/>
                <ComboBoxItem Content="4x"/>
              </ComboBox>

              <TextBlock Text="Visible:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,6,0"/>
              <ComboBox x:Name="ItemsPerPageCombo" Width="70" SelectionChanged="ItemsPerPageCombo_SelectionChanged">
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="32" IsSelected="True"/>
                <ComboBoxItem Content="64"/>
                <ComboBoxItem Content="128"/>
              </ComboBox>
            </StackPanel>
          </Grid>

          <!-- The Scrollable Sprite Cards WrapPanel -->
          <Border Grid.Row="1" Background="#06080D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
            <ScrollViewer x:Name="MatrixScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <WrapPanel x:Name="MatrixWrapPanel" Orientation="Horizontal"/>
            </ScrollViewer>
          </Border>

          <!-- Matrix Footer: Jump Shortcuts -->
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="QuickJumpsPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Quick Jump:" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button Content="$4000 (Screen)" Tag="0x4000" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
              <Button Content="$5B00 (Prog)" Tag="0x5B00" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
              <Button Content="$6000" Tag="0x6000" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
              <Button Content="$8000" Tag="0x8000" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
              <Button Content="$A000" Tag="0xA000" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
              <Button Content="$CDCB (Cyb)" Tag="0xCDCB" Click="QuickJump_Click" Margin="0,0,4,0" Padding="6,2" FontSize="11"/>
            </WrapPanel>
            <Button Grid.Column="1" x:Name="BatchRipButton" Content="⚡ Batch Rip All Visible to Bank" Click="BatchRip_Click" Padding="10,3" Background="#142436" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" ToolTip="Rip all sprites currently visible in this sheet directly into your Sprite Bank"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Right Column: Inspector, Lens & Stride Settings, Ripper Controls -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Large Zoom Preview Card -->
            <Border Background="#06080D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="150" Margin="0,0,0,8">
              <Grid>
                <Image x:Name="SelectedSpritePreview" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="10"/>
                <!-- Flip Overlay Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                  <Button Content="⇄ Flip H" Click="PreviewFlipH_Click" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                  <Button Content="⇅ Flip V" Click="PreviewFlipV_Click" Padding="6,2" FontSize="10"/>
                </StackPanel>
                <!-- Address Tag Top Left -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#80000000" CornerRadius="3" Padding="5,2" Margin="6">
                  <TextBlock x:Name="SelectedAddressBadge" Text="$8000" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                </Border>
              </Grid>
            </Border>

            <!-- Sprite Metadata Summary -->
            <TextBlock x:Name="SelectedDimensionsText" Text="16 × 16 pixels · 32 bytes" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- LENS & STRIDE SETTINGS (GROUP) -->
            <GroupBox Header="SPRITE LENS &amp; FORMAT" Margin="0,0,0,10">
              <Grid Margin="4,6,4,4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Width (cells) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3"/>
                <ComboBox x:Name="WidthCellsCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="LensOption_Changed" Margin="0,3">
                  <ComboBoxItem Content="1 cell (8 px)"/>
                  <ComboBoxItem Content="2 cells (16 px)" IsSelected="True"/>
                  <ComboBoxItem Content="3 cells (24 px)"/>
                  <ComboBoxItem Content="4 cells (32 px)"/>
                  <ComboBoxItem Content="6 cells (48 px)"/>
                  <ComboBoxItem Content="8 cells (64 px)"/>
                </ComboBox>

                <!-- Height (cells or lines) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Height:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3"/>
                <ComboBox x:Name="HeightCellsCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="LensOption_Changed" Margin="0,3">
                  <ComboBoxItem Content="1 cell (8 px)"/>
                  <ComboBoxItem Content="2 cells (16 px)" IsSelected="True"/>
                  <ComboBoxItem Content="21 scanlines (Exolon)"/>
                  <ComboBoxItem Content="3 cells (24 px)"/>
                  <ComboBoxItem Content="4 cells (32 px)"/>
                  <ComboBoxItem Content="6 cells (48 px)"/>
                  <ComboBoxItem Content="8 cells (64 px)"/>
                </ComboBox>

                <!-- Stride Mode -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Layout:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3"/>
                <ComboBox x:Name="LayoutModeCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="LensOption_Changed" Margin="0,3">
                  <ComboBoxItem Content="Linear (Row-by-Row)" IsSelected="True"/>
                  <ComboBoxItem Content="Mask-Interleaved (Bmp+Mask)"/>
                  <ComboBoxItem Content="Column-Major (Font/Tiles)"/>
                  <ComboBoxItem Content="ZX Spectrum Screen"/>
                </ComboBox>

                <!-- Color Palette -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Palette:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3"/>
                <ComboBox x:Name="PaletteCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="LensOption_Changed" Margin="0,3">
                  <ComboBoxItem Content="Bright Green (Phosphor)" IsSelected="True"/>
                  <ComboBoxItem Content="Bright Cyan (Speccy Navy)"/>
                  <ComboBoxItem Content="White on Black"/>
                  <ComboBoxItem Content="Amber (Warm Phosphor)"/>
                  <ComboBoxItem Content="Bright Yellow on Blue"/>
                  <ComboBoxItem Content="Native ULA Attributes (Follows Bmp)"/>
                </ComboBox>

                <!-- Invert Bits / Negative -->
                <CheckBox x:Name="InvertBitsCheck" Grid.Row="4" Grid.Column="1" Content="Invert Bits (Negative)" Click="InvertBits_Click" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,4"/>

                <!-- Scanline Phase Alignment -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Phase Nudge:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                  <Button Content="▲ -1 Byte" Tag="-1" Click="StepAddress_Click" Padding="6,2" Margin="0,0,3,0" ToolTip="Nudge memory address backward 1 byte (Shifts scanlines UP to fix cut-off tops) [Shortcut: ▲ or '[']"/>
                  <Button Content="▼ +1 Byte" Tag="1" Click="StepAddress_Click" Padding="6,2" Margin="0,0,4,0" ToolTip="Nudge memory address forward 1 byte (Shifts scanlines DOWN) [Shortcut: ▼ or ']']"/>
                  <Button Content="🪄 Snap Phase" Click="AutoAlignPhase_Click" Padding="6,2" Background="#183652" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" ToolTip="Auto-snap scanline phase to fix cut off tops or bottoms [Shortcut: 'P']"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <!-- RIP & BANK REGISTRATION (GROUP) -->
            <GroupBox Header="ADD TO SPRITE BANK" Margin="0,0,0,10">
              <StackPanel Margin="4,6,4,4">
                <TextBlock Text="Sprite Name:" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                <TextBox x:Name="SpriteNameBox" Text="Ripped_Sprite_01" Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Category:" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <ComboBox x:Name="RipCategoryCombo">
                      <ComboBoxItem Content="Characters"/>
                      <ComboBoxItem Content="Enemies" IsSelected="True"/>
                      <ComboBoxItem Content="Terrain"/>
                      <ComboBoxItem Content="Platforms"/>
                      <ComboBoxItem Content="Hazards"/>
                      <ComboBoxItem Content="Structures"/>
                      <ComboBoxItem Content="Interactive"/>
                      <ComboBoxItem Content="Scenery"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Source Game:" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <TextBox x:Name="RipSourceGameBox" Text="Custom Ripper"/>
                  </StackPanel>
                </Grid>

                <Button x:Name="AddToBankButton" Content="📥 Add to Sprite Bank" Click="AddToBank_Click" Background="#1D2A42" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Padding="0,7" Margin="0,2,0,4" ToolTip="Add this ripped sprite directly to the Universal Sprite Bank for use across any game"/>
                
                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Content="🎨 Pick as Brush" Click="PickAsBrush_Click" Grid.Column="0" Margin="0,0,2,0" Padding="0,4" ToolTip="Pick this sprite to paint with in the level editor"/>
                  <Button Content="💾 Export PNG..." Click="ExportPng_Click" Grid.Column="1" Margin="2,0,0,0" Padding="0,4" ToolTip="Save this ripped sprite as a PNG file"/>
                </Grid>
              </StackPanel>
            </GroupBox>

            <!-- DETECTED CLUSTERS (AUTO-SCAN RESULTS) -->
            <Expander x:Name="ScanResultsExpander" Header="⚡ DISCOVERED SPRITE CLUSTERS" IsExpanded="True" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,6">
              <StackPanel Margin="2,6,2,2">
                <ListBox x:Name="ScanResultsList" MaxHeight="130" SelectionChanged="ScanResultsList_SelectionChanged" Background="#0A0E17" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock x:Name="ScanStatusText" Text="Click '⚡ Auto-Scan Sprites' to detect sprite banks in this file." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Visual Memory Ripper ready · Scrub memory slider or jump to scan graphics" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="ZX Spectrum 8-Bit Architecture · Speccy Studio" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
