<Window x:Class="SpeccyStudio.ChiptuneScoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="128K AY Chiptune Repository Scout &amp; Mass Ripper — Speccy Studio"
        Width="1260" Height="800" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <!-- DataGrid Custom Styling -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#101724"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowBackground" Value="#131B2B"/>
      <Setter Property="AlternatingRowBackground" Value="#0F1522"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#1E273A"/>
      <Setter Property="VerticalGridLinesBrush" Value="#1E273A"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="RowHeight" Value="28"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#182338"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1B385C"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/> <!-- Repository & Control Panel -->
      <RowDefinition Height="Auto"/> <!-- Telemetry & Progress Bar -->
      <RowDefinition Height="Auto"/> <!-- Filter & Search Strip -->
      <RowDefinition Height="*"/>    <!-- Discovered Games DataGrid -->
      <RowDefinition Height="Auto"/> <!-- Audition & Export Dock -->
    </Grid.RowDefinitions>

    <!-- Top Header & Repository Selector Panel -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand / Title -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#00D2FF" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
              <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
              <TextBlock Text="128K AY CHIPTUNE REPOSITORY SCOUT &amp; MASS RIPPER" FontWeight="Bold" FontSize="15" Foreground="#00D2FF"/>
              <TextBlock Text="Crawl massive game libraries · Detect authentic 50Hz AY-3-8912 drivers ($FFFD/$BFFD) &amp; soundboards · Live audition · Mass export to .PSG &amp; .WAV" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Directory Input & Browse -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Repository Folder:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
          <TextBox x:Name="RepoPathTextBox" Grid.Column="1" VerticalAlignment="Center" Padding="8,6" FontFamily="Consolas" FontSize="12"/>
          <Button x:Name="BrowseRepoBtn" Grid.Column="2" Content="📁 Browse…" Click="BrowseRepo_Click" Margin="8,0,0,0" Padding="12,6"/>
        </Grid>

        <!-- Presets, Options & Actions -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Quick Presets -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Presets:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,6,0"/>
            <Button Content="🎮 TOSEC Games (All)" Click="PresetTosecAll_Click" Padding="8,4" FontSize="11" Background="#162234" ToolTip="Sinclair ZX Spectrum [TOSEC]\Games"/>
            <Button Content="💾 TOSEC [Z80]" Click="PresetTosecZ80_Click" Padding="8,4" FontSize="11" Background="#162234" ToolTip="Sinclair ZX Spectrum [TOSEC]\Games\[Z80]"/>
            <Button Content="📼 TOSEC [TAP]" Click="PresetTosecTap_Click" Padding="8,4" FontSize="11" Background="#162234" ToolTip="Sinclair ZX Spectrum [TOSEC]\Games\[TAP]"/>
            <Button Content="💼 Projects Vault" Click="PresetVault_Click" Padding="8,4" FontSize="11" Background="#162234" ToolTip="Speccy Studio\Projects"/>
          </StackPanel>

          <!-- Options -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <CheckBox x:Name="FastFilterCheck" Content="Fast 128K Filter" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" ToolTip="Scans 128K-tagged files, AY/PSG streams, and known legendary composers at maximum speed"/>
            <CheckBox x:Name="SubdirCheck" Content="Include Subdirectories" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}" ToolTip="Search subdirectories recursively"/>
            <CheckBox x:Name="UseCacheCheck" Content="Use Scan Cache" IsChecked="True" VerticalAlignment="Center" Foreground="#4CC9F0" ToolTip="Uses persistent JSON scan cache to make subsequent scans instantaneous"/>
          </StackPanel>

          <!-- Start / Stop Actions -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StartScoutBtn" Content="🚀 Start Repository Scout" Click="StartScout_Click" Padding="14,6" Background="#0C3B4E" Foreground="#00D2FF" FontWeight="Bold" BorderBrush="#00D2FF"/>
            <Button x:Name="StopScoutBtn" Content="⏹ Stop" Click="StopScout_Click" Padding="14,6" Background="#3D1E22" Foreground="#FA5A68" IsEnabled="False"/>
            <Button x:Name="ClearCacheBtn" Content="🧹 Clear Cache" Click="ClearCache_Click" Padding="8,6" Margin="6,0,0,0" Background="#162234" Foreground="#96A2B7" ToolTip="Clear persistent scan cache to force re-scanning"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Telemetry & Live Progress Bar -->
    <Border Grid.Row="1" Background="#0C1420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ProgressBar x:Name="ScoutProgressBar" Grid.Row="0" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#00D2FF" Background="#070C14" Margin="0,0,0,5"/>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready to scout. Select a repository folder and click Start Scout." Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock x:Name="CurrentFileText" Grid.Column="1" Text="Idle" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Consolas"/>
        </Grid>
      </Grid>
    </Border>

    <!-- Search & Filter Strip -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="230"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="🔎 Filter:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" Padding="6,4" ToolTip="Search by game title, publisher, engine or address..."/>

        <TextBlock Grid.Column="2" Text="Composer:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="14,0,8,0"/>
        <ComboBox x:Name="ComposerFilterCombo" Grid.Column="3" SelectionChanged="ComposerFilter_SelectionChanged">
          <ComboBoxItem Content="All Composers / Drivers" IsSelected="True"/>
          <ComboBoxItem Content="Tim Follin (RoboCop, Ghouls, Chronos)"/>
          <ComboBoxItem Content="Jeroen Tel (Rex, Savage, Myth, Turbo Outrun)"/>
          <ComboBoxItem Content="David Whittaker (180, Glider Rider, Stormbringer)"/>
          <ComboBoxItem Content="Jonathan Dunn (Ocean 128K, Platoon, Batman)"/>
          <ComboBoxItem Content="Ben Daglish (Deflektor, Last Ninja, Trap Door)"/>
          <ComboBoxItem Content="Nick Jones (Exolon, Zynaps, Stormlord)"/>
          <ComboBoxItem Content="J. Dave Rogers (Cybernoid, Netherworld)"/>
          <ComboBoxItem Content="Native AY Modules &amp; PSG Streams"/>
        </ComboBox>

        <TextBlock x:Name="FilterCountText" Grid.Column="5" Text="0 tracks discovered" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
      </Grid>
    </Border>

    <!-- Discovered Games DataGrid -->
    <Border Grid.Row="3" Background="#101724" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
      <DataGrid x:Name="DiscoveredDataGrid" IsReadOnly="True" SelectionChanged="DiscoveredDataGrid_SelectionChanged" MouseDoubleClick="DiscoveredDataGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Game Title" Binding="{Binding DisplayName}" FontWeight="Bold" Width="190"/>
          <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="55"/>
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150"/>
          <DataGridTemplateColumn Header="Composer" Width="135">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="9" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding BadgeBrush}">
                  <TextBlock Text="{Binding ComposerBadge}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Sound Driver / Audio Engine" Binding="{Binding DetectedEngine}" Width="*"/>
          <DataGridTextColumn Header="AY Port / Address" Binding="{Binding DriverAddressFormatted}" FontFamily="Consolas" Width="125"/>
          <DataGridTemplateColumn Header="SFX" Width="70">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Background="#133324" CornerRadius="6" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SfxCountFormatted}" Foreground="#4EFA94" FontWeight="Bold" FontSize="10"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="65"/>
          <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="75"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340"/> <!-- Selected Game Details -->
          <ColumnDefinition Width="*"/>   <!-- Live Preview & Mini Soundboard -->
          <ColumnDefinition Width="Auto"/><!-- Action & Batch Exporters -->
        </Grid.ColumnDefinitions>

        <!-- Left: Selected Game Details -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock x:Name="SelectedTitleText" Text="No game selected" FontWeight="Bold" FontSize="13" Foreground="#00D2FF" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SelectedEngineText" Text="Select a discovered 128K game from the grid above to preview audio." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SelectedDetailsText" Text="Driver Vector: None · Play: None" FontFamily="Consolas" Foreground="#96A2B7" FontSize="10" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Center: Live Audition Player & Mini 8-Pad Soundboard -->
        <Border Grid.Column="1" Background="#0C1420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,14,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Transport Row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
              <TextBlock Text="🎵 Audition:" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"/>
              <Button x:Name="PreviewPlayBtn" Content="▶ Play" Click="PreviewPlay_Click" Width="68" Margin="0,0,4,0" Background="#1D4A32" Foreground="#4EFA94" FontWeight="Bold"/>
              <Button x:Name="PreviewStopBtn" Content="⏹ Stop" Click="PreviewStop_Click" Width="68" Margin="0,0,8,0" Background="#3D1E22" Foreground="#FA5A68"/>
              <CheckBox x:Name="PreviewLoopCheck" Content="Loop" IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="PreviewStatusText" Text="Stopped" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Mini 8-Pad Soundboard Row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🔊 Authentic 128K SFX:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0"/>
              <Button x:Name="SfxPad1" Content="1" Click="SfxPad_Click" Tag="0" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#00D2FF" FontSize="11" ToolTip="Sound effect 1"/>
              <Button x:Name="SfxPad2" Content="2" Click="SfxPad_Click" Tag="1" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#00D2FF" FontSize="11" ToolTip="Sound effect 2"/>
              <Button x:Name="SfxPad3" Content="3" Click="SfxPad_Click" Tag="2" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#00D2FF" FontSize="11" ToolTip="Sound effect 3"/>
              <Button x:Name="SfxPad4" Content="4" Click="SfxPad_Click" Tag="3" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#00D2FF" FontSize="11" ToolTip="Sound effect 4"/>
              <Button x:Name="SfxPad5" Content="5" Click="SfxPad_Click" Tag="4" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#4EFA94" FontSize="11" ToolTip="Sound effect 5"/>
              <Button x:Name="SfxPad6" Content="6" Click="SfxPad_Click" Tag="5" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#4EFA94" FontSize="11" ToolTip="Sound effect 6"/>
              <Button x:Name="SfxPad7" Content="7" Click="SfxPad_Click" Tag="6" Padding="8,2" Margin="0,0,3,0" Background="#1B263B" Foreground="#FFB703" FontSize="11" ToolTip="Sound effect 7"/>
              <Button x:Name="SfxPad8" Content="8" Click="SfxPad_Click" Tag="7" Padding="8,2" Background="#1B263B" Foreground="#FF006E" FontSize="11" ToolTip="Sound effect 8"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Right: Action & Mass Exporters -->
        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="OpenInAudioStudioBtn" Content="🎛 Open in Audio Studio" Click="OpenInAudioStudio_Click" Padding="10,5" Background="#2E1A47" Foreground="#E040FB" FontWeight="Bold" ToolTip="Load this game snapshot and ripped AY stream directly into the full Audio Studio"/>
            <Button x:Name="ExportPsgBtn" Content="💾 .PSG" Click="ExportPsg_Click" Padding="8,5" Background="#1A332E" Foreground="#00E676" FontWeight="SemiBold" ToolTip="Export selected track to .PSG"/>
            <Button x:Name="ExportWavBtn" Content="🎵 .WAV" Click="ExportWav_Click" Padding="8,5" Background="#1D2A42" Foreground="#00D2FF" FontWeight="SemiBold" ToolTip="Export selected track to 44.1kHz WAV"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BatchExportPsgBtn" Content="⚡ Batch Export All .PSG" Click="BatchExportPsg_Click" Padding="8,4" FontSize="11" Background="#132B25" Foreground="#4EFA94" ToolTip="Batch export all discovered/filtered chiptunes to a chosen folder as .PSG files"/>
            <Button x:Name="BatchExportWavBtn" Content="📀 Batch Export All .WAV" Click="BatchExportWav_Click" Padding="8,4" FontSize="11" Background="#1F2438" Foreground="#8C78FF" ToolTip="Batch render all discovered/filtered chiptunes to a chosen folder as 44.1kHz WAV files"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
