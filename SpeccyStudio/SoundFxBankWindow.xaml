<Window x:Class="SpeccyStudio.SoundFxBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound FX Bank &amp; Swapper — Speccy Studio"
        Width="1100" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <!-- DataGrid Custom Styling -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#101724"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowBackground" Value="#131B2B"/>
      <Setter Property="AlternatingRowBackground" Value="#0F1522"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#1E273A"/>
      <Setter Property="VerticalGridLinesBrush" Value="#1E273A"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="RowHeight" Value="28"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#182338"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1B385C"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/> <!-- Header & Presets -->
      <RowDefinition Height="*"/>    <!-- Main: Catalog & Pad Swapper Split -->
      <RowDefinition Height="Auto"/> <!-- Footer / Actions -->
    </Grid.RowDefinitions>

    <!-- Top Banner & Preset Quick-Load -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🎛 SOUND FX BANK &amp; LIVE PAD SWAPPER" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
            <Border Background="#1C334D" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
              <TextBlock x:Name="CatalogCountText" Text="49 Authentic 128K SFX Available" FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Audition, catalog, swap, and assign authentic ZX Spectrum 128K sound effects to live performance pads [1]–[8]." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Preset Pack Selector -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Preset Pack:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
          <ComboBox x:Name="PresetCombo" Width="200" SelectionChanged="PresetCombo_SelectionChanged" FontSize="11">
            <ComboBoxItem Content="All-Stars Highlights Pack" Tag="All" IsSelected="True"/>
            <ComboBoxItem Content="Cybernoid II (Hewson 1988)" Tag="Cybernoid"/>
            <ComboBoxItem Content="Exolon [128K] (Hewson 1987)" Tag="Exolon"/>
            <ComboBoxItem Content="Rex [128K] (Martech 1988)" Tag="Rex"/>
            <ComboBoxItem Content="Myth: History in the Making" Tag="Myth"/>
            <ComboBoxItem Content="David Whittaker 128K Arcade" Tag="Whittaker"/>
            <ComboBoxItem Content="Jonathan Dunn / Ocean Action" Tag="Ocean"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content Area: Split 60% Catalog / 40% Pad Swapper -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/> <!-- Left: Sound Catalog -->
        <ColumnDefinition Width="2*"/> <!-- Right: 8-Pad Soundboard & Swapper -->
      </Grid.ColumnDefinitions>

      <!-- Left Column: Filterable SFX Catalog -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filters -->
            <RowDefinition Height="*"/>    <!-- Table -->
            <RowDefinition Height="Auto"/> <!-- Selected SFX Details & Quick Assign -->
          </Grid.RowDefinitions>

          <!-- Search & Filter Bar -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged" Margin="0,0,6,0" Padding="6,4" Background="#101826" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" FontSize="11" ToolTip="Search sound effect name or description"/>

            <ComboBox x:Name="GameFilterCombo" Grid.Column="1" SelectionChanged="Filter_SelectionChanged" Margin="0,0,6,0" FontSize="11">
              <ComboBoxItem Content="All Games" IsSelected="True"/>
              <ComboBoxItem Content="Cybernoid II"/>
              <ComboBoxItem Content="Exolon"/>
              <ComboBoxItem Content="Rex"/>
              <ComboBoxItem Content="Myth"/>
              <ComboBoxItem Content="Whittaker"/>
              <ComboBoxItem Content="Ocean"/>
            </ComboBox>

            <ComboBox x:Name="CategoryFilterCombo" Grid.Column="2" SelectionChanged="Filter_SelectionChanged" FontSize="11">
              <ComboBoxItem Content="All Categories" IsSelected="True"/>
              <ComboBoxItem Content="Weapons"/>
              <ComboBoxItem Content="Explosions"/>
              <ComboBoxItem Content="Shields"/>
              <ComboBoxItem Content="Movement"/>
              <ComboBoxItem Content="Rewards"/>
              <ComboBoxItem Content="Monsters"/>
              <ComboBoxItem Content="Hazards"/>
              <ComboBoxItem Content="Powerups"/>
            </ComboBox>
          </Grid>

          <!-- SFX Table -->
          <DataGrid x:Name="SfxDataGrid" Grid.Row="1" SelectionChanged="SfxDataGrid_SelectionChanged" MouseDoubleClick="SfxDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Play" Width="45">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="▶" Click="AuditionRow_Click" Padding="4,1" Margin="2" Background="#1D2A42" Foreground="#4EFA94" FontWeight="Bold" FontSize="11" ToolTip="Audition this sound effect"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" FontWeight="SemiBold"/>
              <DataGridTextColumn Header="Game / Origin" Binding="{Binding SourceGame}" Width="120" Foreground="{StaticResource MutedBrush}"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="85" Foreground="{StaticResource AccentBrush}"/>
              <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat={}{0} ms}" Width="65" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Bottom: Selected SFX Card & Assign Buttons -->
          <Border Grid.Row="2" Background="#0F1624" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedSfxTitle" Text="Select a sound effect above" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="SelectedSfxDesc" Text="Double-click row to audition or assign to an 8-pad trigger." FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="▶ Audition" Click="AuditionSelected_Click" Margin="0,0,6,0" Padding="8,4" Background="#1D2A42" Foreground="#4EFA94" FontSize="11"/>
                <Button Content="💾 Export WAV" Click="ExportSelectedWav_Click" Margin="0,0,6,0" Padding="8,4" Background="#26344F" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                <TextBlock Text="Assign to:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0,4,0"/>
                <ComboBox x:Name="TargetPadCombo" Width="70" FontSize="11" Margin="0,0,4,0">
                  <ComboBoxItem Content="Pad 1" IsSelected="True"/>
                  <ComboBoxItem Content="Pad 2"/>
                  <ComboBoxItem Content="Pad 3"/>
                  <ComboBoxItem Content="Pad 4"/>
                  <ComboBoxItem Content="Pad 5"/>
                  <ComboBoxItem Content="Pad 6"/>
                  <ComboBoxItem Content="Pad 7"/>
                  <ComboBoxItem Content="Pad 8"/>
                </ComboBox>
                <Button Content="Assign" Click="AssignToSelectedPad_Click" Padding="8,4" Background="#1B4D3E" Foreground="#4EFA94" FontWeight="SemiBold" FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Right Column: 8-Pad Soundboard Manager & Swapper -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & instructions -->
            <RowDefinition Height="*"/>    <!-- 8 Pad Cards (vertical scroll or 8 rows) -->
            <RowDefinition Height="Auto"/> <!-- Swap Tool & All Export -->
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="CURRENT SOUNDBOARD PADS [1]–[8]" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Press [1]–[8] to audition" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
          </Grid>

          <!-- 8 Pad Rows List -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PadsContainer" Margin="0,0,4,0">
              <!-- Pad entries generated dynamically in code-behind -->
            </StackPanel>
          </ScrollViewer>

          <!-- Bottom: Swap Tool Bar -->
          <Border Grid.Row="2" Background="#101826" CornerRadius="6" Padding="8" Margin="0,8,0,0" BorderBrush="#1C273C" BorderThickness="1">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Swap Pad:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0"/>
                <ComboBox x:Name="SwapPadA" Grid.Column="1" FontSize="11" Margin="0,0,6,0">
                  <ComboBoxItem Content="[1] Pad 1" IsSelected="True"/>
                  <ComboBoxItem Content="[2] Pad 2"/>
                  <ComboBoxItem Content="[3] Pad 3"/>
                  <ComboBoxItem Content="[4] Pad 4"/>
                  <ComboBoxItem Content="[5] Pad 5"/>
                  <ComboBoxItem Content="[6] Pad 6"/>
                  <ComboBoxItem Content="[7] Pad 7"/>
                  <ComboBoxItem Content="[8] Pad 8"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="with" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                <ComboBox x:Name="SwapPadB" Grid.Column="3" FontSize="11" Margin="0,0,6,0">
                  <ComboBoxItem Content="[1] Pad 1"/>
                  <ComboBoxItem Content="[2] Pad 2" IsSelected="True"/>
                  <ComboBoxItem Content="[3] Pad 3"/>
                  <ComboBoxItem Content="[4] Pad 4"/>
                  <ComboBoxItem Content="[5] Pad 5"/>
                  <ComboBoxItem Content="[6] Pad 6"/>
                  <ComboBoxItem Content="[7] Pad 7"/>
                  <ComboBoxItem Content="[8] Pad 8"/>
                </ComboBox>

                <Button Grid.Column="4" Content="⇄ Swap" Click="SwapPads_Click" Padding="8,3" Background="#26344F" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
              </Grid>

              <Button Content="📦 Export All 8 Pads as WAV Pack" Click="ExportAllPads_Click" Padding="8,4" Background="#1D2A42" Foreground="#00D2FF" FontSize="11" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer Action Bar -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready · Sound FX Bank loaded" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Apply to Audio Studio" Click="ApplyAndClose_Click" Margin="0,0,8,0" Padding="12,5" Background="#143D2A" Foreground="#4EFA94" FontWeight="Bold" FontSize="11"/>
          <Button Content="Close" Click="Close_Click" Padding="12,5" Background="#1D2A42" Foreground="{StaticResource TextBrush}" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
