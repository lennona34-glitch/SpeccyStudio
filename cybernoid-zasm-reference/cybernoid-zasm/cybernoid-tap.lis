0000:           
0000:           #target				tap				; declare target file format
0000:           
0000:           ; . . . . . . . . . . .
0000:           ; Equates
0000:           
0000:           ERROR1		equ		$0008
0000:           PRINTA1		equ		$0010
0000:           GETCHAR		equ		$0018
0000:           NEXTCHAR	equ		$0020
0000:           MASKINT		equ		$0038
0000:           
0000:           KEYSCAN		EQU		$028E			
0000:           BEEPER		equ		$03B5			
0000:           BEEP		equ		$03F8
0000:           LDBYTES		equ		$0556			
0000:           POSTORE		equ		$0ADC
0000:           POFETCH		equ		$0B03
0000:           POATTR		equ		$0BDB
0000:           TEMPS		equ		$0D4D
0000:           ROMCLS		equ		$0D6B
0000:           CLSET		equ		$0DD9
0000:           CLADDR		equ		$0E9B
0000:           EDLOOP		equ		$0F38
0000:           EDEDIT		equ		$0FA9
0000:           EDERROR		equ		$107F
0000:           CHANOPEN	equ		$1601			
0000:           STRDATA1	equ		$1727			
0000:           NEXT2NUM	equ		$1C79			
0000:           EXPT2NUM	equ		$1C7A
0000:           EXPT1NUM	equ		$1C82
0000:           EXPTEXP		equ		$1C8C			
0000:           FNDINT1		equ		$1E94			
0000:           FINDINT2	equ		$1E99
0000:           PIXADD		equ		$22AA
0000:           ;PIXADD		equ		OURPIXADD		; Point to our modified PIXADD
0000:           POINT		equ		$22CB			; Coords on stack on entry (use STACKBC), binary result on stack at exit (use FPTOA)
0000:           CRGRE1		equ		$233B			; On entry stack = X Y Z -> Draws circle at X,Y with radius Z
0000:           DRAWLINE	equ		$24B7
0000:           ;DRAWLN2	equ		$24BA			; Use our routine below...
0000:           SCANNING	equ		$24FB
0000:           STKSTORE	equ		$2AB6
0000:           STKFETCH	equ		$2BF1
0000:           DECTOFP		equ		$2C9B
0000:           STACKA		equ		$2D28
0000:           STACKBC		equ		$2D2B
0000:           FPTOBC		equ		$2DA2
0000:           FPTOA		equ		$2DD5
0000:           PRINTFP		equ		$2DE3
0000:           STACKNUM	equ		$33B4	
0000:           
0000:           DFILE		equ		$4000			; Screen coords 0 - 255, 0 (top) - 175 (or 191)
0000:           ATTRS		equ		$5800			; Screen chars 0 - 31, 0 - 21 (or 23)
0000:           
0000:           COMMA_CONTROL equ		$06				
0000:           CHAR_ENTER	equ		$0D				; ASCII CR
0000:           INK_CONTROL	equ		$10				
0000:           PAPER_CONTROL	equ		$11				
0000:           INVERSE_CONTROL	equ		$14				
0000:           AT_CONTROL	equ		$16				
0000:           
0000:           CHAR_SPACE	equ		$20				; ASCII Space
0000:           
0000:           GRAPHICS_SHIFT_3	equ		$8C			; Graphic Shift 3
0000:           
0000:           GRAPHICS_A	equ		$90				; Graphic Char A
0000:           
0000:           KWRDSCREENSTR	equ		$AA				; BASIC Keywords (see pp358-360 of Mastering Machine Code by Toni Baker)
0000:           KWRDAT			equ		$AC
0000:           KWRDCODE		equ		$AF
0000:           KWRDVAL			equ		$B0
0000:           KWRDEXP			equ		$B9
0000:           KWRDUSR			equ		$C0
0000:           KWRDLINE		equ		$CA
0000:           KWRDCAT			equ		$CF
0000:           KWRDBEEP		equ		$D7
0000:           KWRDINK			equ		$D9
0000:           KWRDPAPER		equ		$DA
0000:           KWRDBRIGHT		equ		$DC
0000:           KWRDLPRINT		equ		$E0
0000:           KWRDSTOP		equ		$E2
0000:           KWRDREAD		equ		$E3
0000:           KWRDDATA		equ		$E4
0000:           KWRDRESTORE		equ		$E5
0000:           KWRDBORDER		equ		$E7
0000:           KWRDREM			equ		$EA
0000:           KWRDLOAD		equ		$EF
0000:           KWRDPAUSE		equ		$F2
0000:           KWRDPOKE		equ		$F4
0000:           KWRDPRINT		equ		$F5
0000:           KWRDRANDOMIZE	equ		$F9
0000:           KWRDCLS			equ		$FB
0000:           KWRDCLEAR		equ		$FD
0000:           
0000:           ; . . . . . . . . . . .
0000:           ; Interface 1 Edition 2 equates (as per Fuse 1.0)
0000:           
0000:           MAINROM		equ		$00
0000:           CALBAS		equ		$10				; Call a main ROM routine
0000:           SHERR		equ		$20
0000:           ROMERR		equ		$28
0000:           NEWVAR		equ		$30
0000:           ERR6			equ		$01F0
0000:           NREPORTC		equ		$052F
0000:           STEND		equ		$05B7
0000:           END1			equ		$05C1			
0000:           EXPTNUM		equ		$061E
0000:           NREPORT2		equ		$0663
0000:           CHECKM2		equ		$066D
0000:           NREPORT3		equ		$062D
0000:           UNPAGE		equ		$0700
0000:           NREPORTN		equ		$0906
0000:           OPRSCH		equ		$0B17
0000:           OPSTREAM		equ		$0B51
0000:           TCHANOUT		equ		$0C3A
0000:           BCHANOUT		equ		$0D07
0000:           SETTMCH		equ		$10A5
0000:           DELMBUF		equ		$119F
0000:           RWFERR		equ		$1132
0000:           GETRLP		equ		$125F
0000:           RSSH2		equ		$11A3
0000:           GHDRC		equ		$11A5
0000:           GETMHD2		equ		$13A9
0000:           RESBMAP		equ		$13E3
0000:           DECSECT		equ		$13F7
0000:           CHKSHDR		equ		$1426
0000:           CLOSE		equ		$1718
0000:           SELDRIVE		equ		$1532
0000:           OUTMBUF		equ		$15B3
0000:           GETMBLK		equ		$15F2
0000:           DELAYBC		equ		$1652
0000:           RDSECTOR		equ		$1F3F
0000:           RSSH			equ		$1AC5
0000:           FREESECT		equ		$1D43
0000:           PRCHAR		equ		$1D71
0000:           INCHK		equ		$1E49
0000:           DISPHEX		equ		$14D6
0000:           DISPHEX2		equ		$14ED
0000:           DISPCH		equ		$14F8
0000:           
0000:           ; . . . . . . . . . . .
0000:           ; Constants
0000:           
0000:           FALSE		equ		$00
0000:           TRUE		equ		$01
0000:           
0000:           
0000:           KSTATE		equ 	$5C00 			; Keyboard bytes
0000:           LASTK		equ 	$5C08			; Last keypress
0000:           REPDEL		equ		$5C09			; Delay until repeat starts (Default 35)
0000:           REPPER		equ 	$5C0A			; Key repeat delay (Default 5)
0000:           DEFADD		equ		$5C0B			; Pointer to DEF FN params during eval
0000:           KDATA		equ		$5C0D			; Second byte of colour control from keyboard
0000:           TVDATA		equ		$5C0E			; Both bytes of colour, AT, TAB controls
0000:           STRMS		equ		$5C10			; Address of Stream data
0000:           CHARS		equ		$5C36			; Address - $0100 of character definitions in ROM ($3D00)
0000:           RASP		equ		$5C38			; Duration of buzz (i.e. if no mem for input)
0000:           PIP			equ		$5C39			; Duration of keyboard click (Default 0)
0000:           ERRNR		equ		$5C3A			; Error Report Number - 1 <<< IY Points here
0000:           FLAGS		equ		$5C3B			; Flags (bit 5 = LASTK is valid, bit 1 = Printer output)
0000:           TVFLAG		equ		$5C3C			; Flag bits
0000:           ERRSP		equ		$5C3D			; Pointer to top of stack for RET on error
0000:           LISTSP		equ		$5C3F			; Pointer to return from auto list
0000:           MODE		equ		$5C41			; Keyword, Extended, Graphics or Letters/Caps
0000:           NEWPPC		equ		$5C42			; Next line number of program
0000:           NSPPC		equ		$5C44			; Next statement offset (in next line)
0000:           PPC			equ		$5C45			; Current line number of program
0000:           SUBPPC		equ		$5C47			; Current statement offset (in current line)
0000:           BORDCR		equ		$5C48			; Bits 5, 4, 3 = border colour
0000:           EPPC		equ		$5C49			; Program edit cursor line number
0000:           VARS		equ		$5C4B			; Pointer to first variable
0000:           DEST		equ		$5C4D			; Pointer to variable during assignment
0000:           CHANS		equ		$5C4F			; Pointer to first channel area
0000:           CURCHL		equ		$5C51			; Pointer to current channel area
0000:           PROG		equ		$5C53			; Pointer to first line in program
0000:           NXTLIN		equ		$5C55			; Pointer to next program line
0000:           DATADD		equ		$5C57			; Pointer to just past last data item read
0000:           ELINE		equ		$5C59			; Pointer to edit line
0000:           KCUR		equ		$5C5B			; Pointer to cursor
0000:           CHADD		equ		$5C5D			; Pointer to next char
0000:           XPTR		equ		$5C5F			; Pointer to syntax error
0000:           WORKSP		equ		$5C61			; Pointer to workspace
0000:           STKBOT		equ		$5C63			; Pointer to calculator stack base
0000:           STKEND		equ		$5C65			; Pointer to topmost memory address used by BASIC
0000:           BREG		equ		$5C67			; Byte used for B register of calculator
0000:           MEM			equ		$5C68			; Pointer to calculator memory
0000:           FLAGS2		equ		$5C6A			; Bit flags
0000:           DFSZ		equ		$5C6B			; Lines in lower screen (Default 2)
0000:           STOP		equ		$5C6C			; Line number of top line of auto list
0000:           OLDPPC		equ		$5C6E			; Continuation line number
0000:           OSPCC		equ		$5C70			; Continuation statement number
0000:           FLAGX		equ		$5C71			; Bit flags
0000:           STRLEN		equ		$5C72			; String length during assignment
0000:           TADDR		equ		$5C74			; Pointer to next syntax table item
0000:           SEED		equ		$5C76			; Word used by random number routines
0000:           FRAMES		equ		$5C78			; Frame counter low, med, high bytes
0000:           UDG			equ		$5C7B			; Pointer to bit patterns for user defined graphics
0000:           COORDS		equ		$5C7D			; Plot x,y values
0000:           PPOSN		equ		$5C7F			; Printer position (Range 33-02)
0000:           PRCC		equ		$5C80			; Low byte of next address in printer buffer
0000:           									; $5C81 Unused
0000:           ECHOE		equ		$5C82			; Column, line for input buffer
0000:           DFCC		equ		$5C84			; Next screen location for print
0000:           DFCCL		equ		$5C86			; Next screen location for print (lower screen)
0000:           SPOSN		equ		$5C88			; Screen column (32-02), screen row (24-01)
0000:           SPOSNL		equ		$5C8A			; Screen column (32-02), screen row (24-01) (lower screen)
0000:           SCRCT		equ		$5C8C			; Remaining scroll count + 1 (0 is maximum)
0000:           ATTRP		equ		$5C8D			; Screen colours
0000:           MASKP		equ 	$5C8E			; Defines the transparent screen colours
0000:           ATTRT		equ		$5C8F			; Temporary colours
0000:           MASKT		equ		$5C90			; Defines the transparent temporary screen colours
0000:           PFLAG		equ		$5C91			; Bit flags
0000:           MEMBOT		equ		$5C92			; Scratchpad area for calculator routines
0000:           SPARE2		equ		$5CB0			; Pointer used by NMI routine at $0066
0000:           RAMTOP		equ		$5CB2			; Pointer to highest stack byte (value $3E)
0000:           PRAMT		equ 	$5CB4			; Highest byte that passed RAM test
0000:           
0000:           
0000:           KSTATEOFF	equ		KSTATE-ERRNR	; Offsets for use in (IY+n)
0000:           LASTKOFF	equ		LASTK-ERRNR		
0000:           REPDELOFF	equ		REPDEL-ERRNR	
0000:           REPPEROFF	equ		REPPER-ERRNR	
0000:           DEFADDOFF	equ		DEFADD-ERRNR	
0000:           KDATAOFF	equ		KDATA-ERRNR		
0000:           TVDATAOFF	equ		TVDATA-ERRNR	
0000:           STRMSOFF	equ		STRMS-ERRNR		
0000:           CHARSOFF	equ		CHARS-ERRNR		
0000:           RASPOFF		equ		RASP-ERRNR		
0000:           PIPOFF		equ		PIP-ERRNR		
0000:           ERRNROFF	equ		ERRNR-ERRNR		
0000:           FLAGSOFF	equ		FLAGS-ERRNR		
0000:           TVFLAGOFF	equ		TVFLAG-ERRNR	
0000:           ERRSPOFF	equ		ERRSP-ERRNR		
0000:           LISTSPOFF	equ		LISTSP-ERRNR	
0000:           MODEOFF		equ		MODE-ERRNR		
0000:           NEWPPCOFF	equ		NEWPPC-ERRNR	
0000:           NSPPCOFF	equ		NSPPC-ERRNR		
0000:           PPCOFF		equ		PPC-ERRNR		
0000:           SUBPPCOFF	equ		SUBPPC-ERRNR	
0000:           BORDCROFF	equ		BORDCR-ERRNR	
0000:           EPPCOFF		equ		EPPC-ERRNR		
0000:           VARSOFF		equ		VARS-ERRNR		
0000:           DESTOFF		equ		DEST-ERRNR		
0000:           CHANSOFF	equ		CHANS-ERRNR		
0000:           CURCHLOFF	equ		CURCHL-ERRNR	
0000:           PROGOFF		equ		PROG-ERRNR		
0000:           NXTLINOFF	equ		NXTLIN-ERRNR	
0000:           DATADDOFF	equ		DATADD-ERRNR	
0000:           ELINEOFF	equ		ELINE-ERRNR		
0000:           KCUROFF		equ		KCUR-ERRNR		
0000:           CHADDOFF	equ		CHADD-ERRNR		
0000:           XPTROFF		equ		XPTR-ERRNR		
0000:           WORKSPOFF	equ		WORKSP-ERRNR	
0000:           STKBOTOFF	equ		STKBOT-ERRNR	
0000:           STKENDOFF	equ		STKEND-ERRNR	
0000:           BREGOFF		equ		BREG-ERRNR		
0000:           MEMOFF		equ		MEM-ERRNR		
0000:           FLAGS2OFF	equ		FLAGS2-ERRNR	
0000:           DFSZOFF		equ		DFSZ-ERRNR		
0000:           
0000:           ATTRTOFF		equ		ATTRT-ERRNR	
0000:           
0000:           ; -----------------------------
0000:           ; THE 'SHADOW' SYSTEM VARIABLES
0000:           ; -----------------------------
0000:           
0000:           FLAGS3		equ $5CB6				; $5CB6 FLAGS3 IY+$7C - Flags
0000:           VECTOR		equ $5CB7				; $5CB7 VECTOR Address used to extend BASIC.
0000:           SBRT			equ $5CB9				; $5CB9 SBRT 10 bytes of Z80 code to Page ROM.
0000:           BAUD			equ $5CC3				; $5CC3 BAUD =(3500000/(26*baud rate)) -2
0000:           NTSTAT		equ $5CC5				; $5CC5 NTSTAT Own network station number.
0000:           IOBORD		equ $5CC6				; $5CC6 IOBORD Border colour during I/O
0000:           SERFL		equ $5CC7				; $5CC7 SER_FL 2 byte workspace used by RS232
0000:           SECTOR		equ $5CC9				; $5CC9 SECTOR 2 byte workspace used by Microdrive.
0000:           CHADD_		equ $5CCB				; $5CCB CHADD_ Temporary store for CH_ADD
0000:           NTRESP		equ $5CCC				; $5CCC NTRESP Store for network response code.
0000:           
0000:           NTDEST		equ $5CCD				; $5CCD NTDEST Destination station number 0 - 64.
0000:           NTSRCE		equ $5CCE				; $5CCE NTSRCE Source station number.
0000:           NTNUMB		equ $5CD0				; $5CD0 NTNUMB Network block number 0 - 65535
0000:           NTTYPE		equ $5CD2				; $5CD2 NTTYPE Header type block.
0000:           NTLEN		equ $5CD3				; $5CD3 NTLEN Data block length 0 - 255.
0000:           NTDCS		equ $5CD4				; $5CD4 NTDCS Data block checksum.
0000:           NTHDS		equ $5CD5				; $5CD5 NTHDS Header block checksum.
0000:           
0000:           DSTR1		equ $5CD6				; $5CD6 D_STR1 2 byte drive number 1 - 8.
0000:           SSTR1		equ $5CD8				; $5CD8 S_STR1 Stream number 1 - 15.
0000:           LSTR1		equ $5CD9				; $5CD9 L_STR1 Device type "M", "N", "T" or "B"
0000:           NSTR1		equ $5CDA				; $5CDA N-STR1 Length of filename.
0000:           								; $5CDC (dynamic) Address of filename.
0000:           
0000:           DSTR2		equ $5CDE				; $5CDE D_STR2 2 byte drive  File type.
0000:           								; $5CDF        number.       Length of
0000:           SSTR2		equ $5CE0				; $5CE0 S_STR2 Stream number.Data.
0000:           LSTR2		equ $5CE1				; $5CE1 L_STR2 Device type.  Start of
0000:           NSTR2		equ $5CE2				; $5CE2 N-STR2 Length of     data.   \
0000:           								; $5CE3        filename.     Program  \
0000:           								; $5CE4 (dynamic) Address of length. Start of
0000:           								; $5CE5 (dynamic) filename           data.
0000:           
0000:           HD00			equ $5CE6				; $5CE6 HD_00 File type .      _
0000:           HD0B			equ $5CE7				; $5CE7 HD_0B Length of data.   /\
0000:           HD0D			equ $5CE9				; $5CE9 HD_0D Start of data.   /
0000:           HD0F			equ $5CEB				; $5CEB HD_0F Program length. /
0000:           HD11			equ $5CED				; $5CED HD_11 Line number.
0000:           
0000:           COPIES		equ $5CEF				; $5CEF COPIES Number of copies made by SAVE.
0000:           
0000:           CHREC		equ	$0D
0000:           CHDRIV		equ	$19				; Offset to DSTR1
0000:           HDNUMB		equ	$29
0000:           
0000:           
0000:           
0000:           ; . . . . . . . . . . .
0000:           ; Constants
0000:           
0000:           HEADERFLAG	equ $00				; As per http://k1.dyndns.org/Develop/projects/zasm/doc/z13.htm#L
0000:           DATAFLAG	equ $FF
0000:           
0000:           
0000:           ; . . . . . . . . . . .
0000:           ; BASIC Program Header
0000:           
0000:           
FFFFFFFD: 000000    #code				0,17,HEADERFLAG	; declare code segment
0000:           
0000: 00        			defb 0				; Program
0001: 63796265
0005: 726E6F69
0009: 6420      			defm "cybernoid "	; Pad to 10 chars
000B: 6400      			defw PROGRAM1END
000D: 0A00      			defw 10				; BASIC Line number for autostart
000F: 6400      			defw PROGRAM1END    ; length of BASIC program without variables
0011:           
0011:           
0011:           ; . . . . . . . . . . .
0011:           ; BASIC Program
0011:           
0011:           
FFFFFFFD: 0000FF    #code				0,$200,DATAFLAG	; declare code segment
0000:           
0000:           ; 10 BORDER 0: PAPER 0: INK 7: CLEAR 24835				; $6103
0000: 000A      			defb 0,10   		; line number
0002: 28        			defb L10END-($+1)	; line length
0003: 00        			defb 0				; statement number
0004: E7        			defb KWRDBORDER		; token BORDER
0005: 300E0000
0009: 000000            	defm "0",$0e0000000000   ; number 0, ascii & internal format
000C: 3A        			defb ':'
000D: DA        			defb KWRDPAPER		; token PAPER
000E: 300E0000
0012: 000000            	defm "0",$0e0000000000   ; number 0, ascii & internal format
0015: 3A        			defb ':'
0016: D9        			defb KWRDINK		; token INK
0017: 370E0000
001B: 070000            	defm "7",$0e0000070000   ; number 7, ascii & internal format
001E: 3A         			defb ':'
001F: FD                	defb KWRDCLEAR		; token CLEAR
0020: 32343833
0024: 350E0000
0028: 036100            	defm "24835",$0e0000036100   ; number 24835, ascii & internal format
002B: 0D        L10END		defb $0D			; line end marker
002C:           
002C:           ; 20 LOAD "" CODE SCREEN$: PAUSE 0			; $4000
002C: 0014      			defb 0,20			; line number
002E: 0E        			defb L20END-($+1)	; line length
